{
    "name": "train_palette_gelsight_phase2_v2",
    "gpu_ids": [
        0
    ],
    "seed": 42,
    "finetune_norm": false,
    "path": {
        "base_dir": "experiments",
        "code": "code",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null
    },
    "datasets": {
        "train": {
            "which_dataset": {
                "name": [
                    "agentic_sr.data.gelsight",
                    "GelsightAreaInpaintDataset"
                ],
                "args": {
                    "config": "v2",
                    "image_size": [
                        320,
                        240
                    ],
                    "grid": [
                        10,
                        10
                    ],
                    "mask_k_range": [
                        5,
                        95
                    ],
                    "rotk": 1,
                    "data_len": -1
                }
            },
            "dataloader": {
                "validation_split": 2,
                "args": {
                    "batch_size": 4,
                    "num_workers": 2,
                    "shuffle": true,
                    "pin_memory": true,
                    "drop_last": true
                },
                "val_args": {
                    "batch_size": 1,
                    "num_workers": 0,
                    "shuffle": false,
                    "pin_memory": true,
                    "drop_last": false
                }
            }
        },
        "test": {
            "which_dataset": {
                "name": [
                    "agentic_sr.data.gelsight",
                    "GelsightAreaInpaintDataset"
                ],
                "args": {
                    "config": "v2",
                    "image_size": [
                        320,
                        240
                    ],
                    "grid": [
                        10,
                        10
                    ],
                    "mask_k_range": [
                        5,
                        95
                    ],
                    "rotk": 1,
                    "data_len": -1
                }
            },
            "dataloader": {
                "args": {
                    "batch_size": 1,
                    "num_workers": 0,
                    "pin_memory": true
                }
            }
        }
    },
    "model": {
        "which_model": {
            "name": [
                "agentic_sr.models.palette_crossmodal",
                "CrossModalPalette"
            ],
            "args": {
                "sample_num": 4,
                "task": "inpainting",
                "ema_scheduler": {
                    "ema_start": 1,
                    "ema_iter": 1,
                    "ema_decay": 0.9999
                },
                "optimizers": [
                    {
                        "lr": 5e-05,
                        "weight_decay": 0
                    }
                ]
            }
        },
        "which_networks": [
            {
                "name": [
                    "models.network",
                    "Network"
                ],
                "args": {
                    "init_type": "kaiming",
                    "module_name": "guided_diffusion",
                    "unet": {
                        "in_channel": 4,
                        "out_channel": 1,
                        "inner_channel": 64,
                        "channel_mults": [
                            1,
                            2,
                            4,
                            8
                        ],
                        "attn_res": [
                            8
                        ],
                        "num_head_channels": 32,
                        "res_blocks": 2,
                        "dropout": 0.2,
                        "image_size": 320
                    },
                    "beta_schedule": {
                        "train": {
                            "schedule": "linear",
                            "n_timestep": 2000,
                            "linear_start": 1e-06,
                            "linear_end": 0.01
                        },
                        "test": {
                            "schedule": "linear",
                            "n_timestep": 1000,
                            "linear_start": 0.0001,
                            "linear_end": 0.09
                        }
                    }
                }
            }
        ],
        "which_losses": [
            "mse_loss"
        ],
        "which_metrics": [
            "mae"
        ]
    },
    "train": {
        "n_epoch": 100000,
        "n_iter": 50000,
        "val_epoch": 200,
        "save_checkpoint_epoch": 200,
        "log_iter": 500,
        "tensorboard": true
    },
    "debug": {
        "n_epoch": 1,
        "n_iter": 100000000,
        "val_epoch": 1,
        "save_checkpoint_epoch": 100000,
        "log_iter": 2,
        "debug_split": 6
    },
    "phase": "train",
    "distributed": false
}